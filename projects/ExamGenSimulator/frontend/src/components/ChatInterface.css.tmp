.chat-interface {
  max-width: 800px;
  margin: 0 auto;
  height: 600px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5rem;
  border-bottom: 1px solid var(--gray-200);
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10px);
}

.chat-title {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 600;
  color: var(--gray-800);
  font-size: 1.1rem;
}

.chat-title svg {
  color: var(--avanade-orange);
}

.chat-status {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.chat-id {
  font-size: 0.75rem;
  color: var(--gray-500);
  background: var(--gray-100);
  padding: 4px 8px;
  border-radius: 12px;
}

.chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  background: rgba(255, 255, 255, 0.4);
}

.message {
  display: flex;
  gap: 12px;
  animation: fadeIn 0.3s ease-out;
}

.user-message {
  align-self: flex-end;
  flex-direction: row-reverse;
  max-width: 80%;
}

.bot-message {
  align-self: flex-start;
  max-width: 85%;
}

.message-avatar {
  width: 36px;
  height: 36px;
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4px;
}

.user-message .message-avatar {
  background: var(--gradient-glow);
  color: white;
  box-shadow: 0 2px 8px rgba(255, 102, 0, 0.3);
}

.bot-message .message-avatar {
  background: var(--gray-100);
  color: var(--avanade-orange);
  border: 2px solid rgba(255, 102, 0, 0.2);
}

.evaluation-message {
  align-self: flex-start;
  max-width: 85%;
}

.evaluation-message .message-avatar {
  background: var(--avanade-blue);
  color: white;
  border: 2px solid rgba(59, 130, 246, 0.3);
}

.message-content {
  flex: 1;
  min-width: 0;
}